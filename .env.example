# ============================================================
# Plantilla de variables de entorno
# ============================================================
# Copia este archivo a .env.local y rellena los valores reales.
# .env.local NUNCA se sube a git (está en .gitignore).
#
# En producción (Vercel), estas variables se configuran desde
# Vercel Dashboard > Project Settings > Environment Variables.

# --- Supabase ----------------------------------------------
# Tu proyecto Supabase. Encuéntralo en Supabase Dashboard > Project Settings > API
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# ⚠ SECRETO: full DB access, salta RLS. SOLO server-side.
# NO uses esta key en el frontend ni la commits a git.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# --- Vercel ------------------------------------------------
VERCEL_PROJECT_ID=prj_xxxxxxxxxx
