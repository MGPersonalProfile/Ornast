---
import Reader from '@layouts/Reader.astro';
import ChapterNav from '@components/ChapterNav.astro';
import { getCollection, getEntry, render } from 'astro:content';
import {
  getCapituloNumero,
  getCapituloSlug,
  getActoDeCapitulo,
  toRoman,
  extraerTitulo,
  parsearTitulo,
  detectarBannerActo,
} from '@lib/chapters';

export async function getStaticPaths() {
  const libros = await getCollection('libros');
  const capitulos = await getCollection('capitulos');
  const paths: any[] = [];
  for (const libro of libros) {
    const libroSlug = libro.id.split('/')[0]!;
    const capsLibro = capitulos.filter((c) => c.id.startsWith(`${libroSlug}/`));
    for (const cap of capsLibro) {
      const capSlug = getCapituloSlug(cap.id);
      paths.push({
        params: { libro: libroSlug, capitulo: capSlug },
        props: { capituloId: cap.id, libroId: libro.id },
      });
    }
  }
  return paths;
}

const { libro } = Astro.params;
const { capituloId, libroId } = Astro.props;

const libroEntry = await getEntry('libros', libroId);
if (!libroEntry) throw new Error(`Libro no encontrado: ${libroId}`);

const capituloEntry = await getEntry('capitulos', capituloId);
if (!capituloEntry) throw new Error(`Capítulo no encontrado: ${capituloId}`);

const todosCapitulos = await getCollection('capitulos');
const capitulosLibro = todosCapitulos
  .filter((c) => c.id.startsWith(`${libro}/`))
  .sort((a, b) => getCapituloNumero(a.id) - getCapituloNumero(b.id));

const numero = getCapituloNumero(capituloEntry.id);
const idx = capitulosLibro.findIndex((c) => c.id === capituloEntry.id);
const prev = idx > 0 ? capitulosLibro[idx - 1] : null;
const next = idx < capitulosLibro.length - 1 ? capitulosLibro[idx + 1] : null;

const isApertura = numero === 0;
const acto = isApertura ? null : getActoDeCapitulo(numero, libro!);
const numeral = toRoman(numero);

// Extraer título del body para el chapter-head
const rawBody = capituloEntry.body ?? '';
const titulo = extraerTitulo(rawBody);
const tituloParseado = parsearTitulo(titulo);
const bannerActo = detectarBannerActo(rawBody);

// Renderizar el markdown
const { Content } = await render(capituloEntry);

// Metadatos de página
const pageTitle = isApertura
  ? 'Apertura'
  : tituloParseado.nombre
    ? `${tituloParseado.nombre} · Cap. ${numero}`
    : `Capítulo ${numero}`;

const description = isApertura
  ? `Apertura de ${libroEntry.data.titulo}. ${libroEntry.data.descripcion}`
  : `Capítulo ${numero} de ${libroEntry.data.titulo}. POV: ${tituloParseado.nombre}.`;

const topbarTitle = isApertura ? 'Apertura' : `Capítulo ${numero} · ${tituloParseado.nombre}`;

const totalNarrativos = capitulosLibro.filter((c) => getCapituloNumero(c.id) >= 1).length;
const pageMeta = isApertura ? 'Apertura' : `${String(numero).padStart(2, '0')} de ${String(totalNarrativos).padStart(2, '0')}`;

const prevSlug = prev ? getCapituloSlug(prev.id) : null;
const prevNum = prev ? getCapituloNumero(prev.id) : -1;
const prevHref = prev ? `/${libro}/${prevSlug}` : undefined;
const prevLabel = prev
  ? prevNum === 0
    ? 'Apertura'
    : parsearTitulo(extraerTitulo(prev.body ?? '')).nombre || `Capítulo ${prevNum}`
  : undefined;

const nextSlug = next ? getCapituloSlug(next.id) : null;
const nextNum = next ? getCapituloNumero(next.id) : -1;
const nextHref = next ? `/${libro}/${nextSlug}` : undefined;
const nextLabel = next
  ? nextNum === 0
    ? 'Apertura'
    : parsearTitulo(extraerTitulo(next.body ?? '')).nombre || `Capítulo ${nextNum}`
  : undefined;

const estadoLabel =
  libroEntry.data.estado === 'activo'
    ? 'En curso'
    : libroEntry.data.estado === 'planeado'
      ? 'Planeado'
      : 'Completado';
---

<Reader
  title={pageTitle}
  description={description}
  libroSlug={libro!}
  libroTitulo={libroEntry.data.titulo}
  estadoLibro={estadoLabel}
  capitulos={capitulosLibro}
  currentNumero={numero}
  topbarTitle={topbarTitle}
>
  <article class:list={['prose', { prologue: isApertura }]}>
    {!isApertura && (
      <>
        {bannerActo && (
          <div class="act-banner">
            <span class="act-banner-num">Acto {bannerActo.num}</span>
            <span class="act-banner-name">{bannerActo.name}</span>
          </div>
        )}
        <div class="chapter-head">
          {acto && (
            <div class="ch-act">Acto {acto.num} · Capítulo {numero}</div>
          )}
          <div class="ch-numeral">{numeral}</div>
          <div class="ch-meta">
            <span class="meta-name">{tituloParseado.nombre}</span>
            {tituloParseado.detalles.length > 0 && (
              <Fragment>
                <br />
                {tituloParseado.detalles.map((d, i) => (
                  <Fragment>
                    {i > 0 && <span class="meta-sep">&nbsp;·&nbsp;</span>}
                    <span class="meta-token">{d}</span>
                  </Fragment>
                ))}
              </Fragment>
            )}
          </div>
        </div>
      </>
    )}
    <Content />
  </article>

  <ChapterNav
    prevHref={prevHref}
    prevLabel={prevLabel}
    nextHref={nextHref}
    nextLabel={nextLabel}
    pageMeta={pageMeta}
  />
</Reader>

<style>
  .prose {
    max-width: var(--reader-max);
    margin: 0 auto;
    padding: 4.5rem var(--reader-pad) 6rem;
    outline: none;
  }

  .chapter-head {
    margin-bottom: 3.2rem;
    text-align: center;
  }
  .ch-numeral {
    display: block;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3.4rem, 8vw, 5.2rem);
    line-height: 1;
    color: var(--accent);
    letter-spacing: 0.06em;
    margin-bottom: 1rem;
  }
  .ch-act {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 1.4rem;
  }
  .ch-meta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-soft);
    line-height: 1.6;
  }
  .meta-name {
    color: var(--text);
    font-weight: 500;
  }
  .meta-sep {
    color: var(--text-faint);
  }

  .act-banner {
    text-align: center;
    margin: 0 auto 3rem;
    padding: 1.6rem 0 1.4rem;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    max-width: 28rem;
  }
  .act-banner-num {
    display: block;
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--accent);
    letter-spacing: 0.12em;
    margin-bottom: 0.4rem;
  }
  .act-banner-name {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--text-soft);
  }
</style>
