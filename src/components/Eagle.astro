---
interface Props {
  size?: number;
  class?: string;
}
const { size = 60, class: className = '' } = Astro.props;
const height = Math.round(size * 0.3);
---

<svg
  viewBox="0 0 80 24"
  width={size}
  height={height}
  fill="none"
  stroke="currentColor"
  stroke-width="1.2"
  stroke-linecap="square"
  class={className}
  aria-hidden="true"
>
  <polyline points="2,4 16,12 2,20" />
  <polyline points="78,4 64,12 78,20" />
  <circle cx="40" cy="12" r="2" fill="currentColor" stroke="none" />
  <line x1="20" y1="12" x2="36" y2="12" />
  <line x1="44" y1="12" x2="60" y2="12" />
</svg>
