---
// Modal de búsqueda full-text. Carga /search-index.json al abrirse.
// Atajo: `/` o `Shift+F` desde cualquier página.
---

<div class="search-modal" id="search-modal" hidden>
  <div class="search-backdrop" id="search-backdrop"></div>
  <div class="search-panel" role="dialog" aria-label="Buscar en el expediente">
    <div class="search-input-row">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" aria-hidden="true">
        <circle cx="11" cy="11" r="6"/>
        <line x1="15.5" y1="15.5" x2="20" y2="20"/>
      </svg>
      <input
        type="text"
        id="search-input"
        placeholder="Buscar palabra, frase, nombre…"
        autocomplete="off"
        spellcheck="false"
        aria-label="Buscar"
      />
      <button class="search-close" id="search-close" aria-label="Cerrar búsqueda">esc</button>
    </div>
    <div class="search-hint" id="search-hint">Escribe para buscar en el expediente.</div>
    <div class="search-results" id="search-results"></div>
  </div>
</div>

<script>
  type Entry = {
    libroSlug: string;
    libroTitulo: string;
    numero: number;
    slug: string;
    url: string;
    nombre: string;
    texto: string;
  };

  let indexCache: Entry[] | null = null;
  let loadingPromise: Promise<Entry[]> | null = null;
  let searchDebounce: number | null = null;

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] || c)
    );
  }

  function escapeRegex(s: string): string {
    return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  async function loadIndex(): Promise<Entry[]> {
    if (indexCache) return indexCache;
    if (loadingPromise) return loadingPromise;
    loadingPromise = fetch('/search-index.json')
      .then((r) => r.json())
      .then((data: Entry[]) => {
        indexCache = data;
        return data;
      });
    return loadingPromise;
  }

  function snippet(text: string, idx: number, term: string): string {
    const before = Math.max(0, idx - 80);
    const after = Math.min(text.length, idx + term.length + 100);
    const left = (before > 0 ? '…' : '') + text.slice(before, idx);
    const match = text.slice(idx, idx + term.length);
    const right = text.slice(idx + term.length, after) + (after < text.length ? '…' : '');
    return `${escapeHtml(left)}<mark>${escapeHtml(match)}</mark>${escapeHtml(right)}`;
  }

  function runSearch(q: string, entries: Entry[]) {
    const results: { entry: Entry; snippet: string }[] = [];
    const term = q.toLowerCase();
    let totalChapters = new Set<string>();

    for (const entry of entries) {
      const lower = entry.texto.toLowerCase();
      let idx = lower.indexOf(term);
      let count = 0;
      while (idx !== -1 && count < 3) {
        results.push({ entry, snippet: snippet(entry.texto, idx, term) });
        totalChapters.add(entry.url);
        idx = lower.indexOf(term, idx + term.length);
        count++;
      }
    }

    const hint = document.getElementById('search-hint')!;
    const out = document.getElementById('search-results')!;

    if (results.length === 0) {
      hint.textContent = `Sin resultados para "${q}".`;
      out.innerHTML = '<div class="search-empty">Nada encontrado.</div>';
      return;
    }

    hint.textContent = `${results.length} resultado${results.length === 1 ? '' : 's'} en ${totalChapters.size} capítulo${totalChapters.size === 1 ? '' : 's'}.`;

    out.innerHTML = results
      .map(
        (r) => `
        <a class="search-result" href="${r.entry.url}" data-url="${r.entry.url}">
          <span class="sr-cap">Cap. ${String(r.entry.numero).padStart(2, '0')} · ${escapeHtml(r.entry.nombre)}</span>
          <span class="sr-snippet">${r.snippet}</span>
        </a>
      `
      )
      .join('');
  }

  function openSearch() {
    const modal = document.getElementById('search-modal')!;
    modal.hidden = false;
    const input = document.getElementById('search-input') as HTMLInputElement;
    input.value = '';
    document.getElementById('search-results')!.innerHTML = '';
    document.getElementById('search-hint')!.textContent = 'Cargando expediente…';
    setTimeout(() => input.focus(), 30);
    loadIndex().then(() => {
      document.getElementById('search-hint')!.textContent = 'Escribe para buscar en el expediente.';
    });
  }

  function closeSearch() {
    document.getElementById('search-modal')!.hidden = true;
  }

  document.getElementById('search-close')?.addEventListener('click', closeSearch);
  document.getElementById('search-backdrop')?.addEventListener('click', closeSearch);
  document.getElementById('search-input')?.addEventListener('input', (e) => {
    const q = (e.target as HTMLInputElement).value.trim();
    if (searchDebounce) window.clearTimeout(searchDebounce);
    searchDebounce = window.setTimeout(async () => {
      if (!q) {
        document.getElementById('search-results')!.innerHTML = '';
        document.getElementById('search-hint')!.textContent = 'Escribe para buscar en el expediente.';
        return;
      }
      const entries = await loadIndex();
      runSearch(q, entries);
    }, 120);
  });
  document.getElementById('search-input')?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSearch();
    if (e.key === 'Enter') {
      const first = document.querySelector<HTMLAnchorElement>('.search-result');
      if (first) {
        e.preventDefault();
        first.click();
      }
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.key === 'Escape') {
      if (!document.getElementById('search-modal')!.hidden) closeSearch();
      return;
    }
    if (e.key === '/' || (e.key === 'F' && e.shiftKey)) {
      e.preventDefault();
      openSearch();
    }
  });

  // Expose para botón externo
  (window as any).ornastOpenSearch = openSearch;
</script>

<style>
  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 150;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 8vh 1rem 1rem;
  }
  .search-modal[hidden] { display: none; }

  .search-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    animation: ornFadeIn 0.18s ease forwards;
    opacity: 0;
  }
  @keyframes ornFadeIn { to { opacity: 1; } }

  .search-panel {
    position: relative;
    width: 100%;
    max-width: 42rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    box-shadow: var(--shadow);
    border-radius: 4px;
    overflow: hidden;
    animation: ornPanelIn 0.22s cubic-bezier(0.4, 0.1, 0.2, 1) forwards;
    opacity: 0;
    transform: translateY(-8px);
  }
  @keyframes ornPanelIn { to { opacity: 1; transform: translateY(0); } }

  .search-input-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 1.2rem;
    border-bottom: 1px solid var(--rule-soft);
    color: var(--text-soft);
  }

  #search-input {
    flex: 1;
    background: transparent;
    border: 0;
    outline: none;
    font: inherit;
    font-family: var(--font-body);
    font-size: 1.1rem;
    color: var(--text);
  }
  #search-input::placeholder { color: var(--text-faint); font-style: italic; }

  .search-close {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: 3px;
    transition: color 0.15s ease, border-color 0.15s ease;
    background: transparent;
    cursor: pointer;
  }
  .search-close:hover { color: var(--accent); border-color: var(--accent); }

  .search-hint {
    padding: 0.6rem 1.2rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
    border-bottom: 1px solid var(--rule-soft);
  }

  .search-results {
    max-height: 56vh;
    overflow-y: auto;
    padding: 0.4rem 0 0.8rem;
  }

  .search-result {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.85rem 1.2rem;
    border-left: 2px solid transparent;
    transition: background 0.15s ease, border-color 0.15s ease;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
  }
  .search-result:hover {
    background: var(--surface-2);
    border-left-color: var(--accent);
  }
  .search-result .sr-cap {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.35rem;
  }
  .search-result .sr-snippet {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--text);
    font-style: italic;
  }
  .search-result :global(mark) {
    background: var(--selection);
    color: var(--text);
    font-style: normal;
    font-weight: 500;
    padding: 0 0.1em;
  }
  .search-result + .search-result { border-top: 1px solid var(--rule-soft); }

  .search-empty {
    padding: 2rem 1.2rem;
    text-align: center;
    font-family: var(--font-body);
    font-style: italic;
    color: var(--text-faint);
  }
</style>
