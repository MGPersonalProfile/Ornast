{
  // === MODO ESCRITOR ===
  // Configuración optimizada para escritura creativa en español

  // Fuente y tipografía
  "editor.fontFamily": "'Cascadia Code', 'Consolas', monospace",
  "editor.fontSize": 16,
  "editor.lineHeight": 1.8,
  "editor.letterSpacing": 0.3,
  
  // Experiencia de escritura
  "editor.wordWrap": "wordWrapColumn",
  "editor.wordWrapColumn": 80,
  "editor.lineNumbers": "off",
  "editor.glyphMargin": false,
  "editor.folding": false,
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "none",
  "editor.renderLineHighlight": "none",
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.scrollBeyondLastLine": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.padding.top": 40,
  "editor.padding.bottom": 40,
  
  // Breadcrumbs y barra lateral
  "breadcrumbs.enabled": false,
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.horizontal": "hidden",
  
  // Corrector ortográfico en español
  "cSpell.language": "es,en",
  "cSpell.enabled": true,
  "cSpell.diagnosticLevel": "Hint",
  
  // Markdown
  "markdown.preview.fontSize": 16,
  "markdown.preview.lineHeight": 1.8,
  "[markdown]": {
    "editor.quickSuggestions": false,
    "editor.suggest.showWords": false,
    "editor.acceptSuggestionOnEnter": "off",
    "editor.tabCompletion": "off",
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 80,
    "editor.defaultFormatter": "yzhang.markdown-all-in-one"
  },
  
  // Desactivar distracciones de código
  "editor.suggestOnTriggerCharacters": false,
  "editor.parameterHints.enabled": false,
  "editor.hover.enabled": false,
  
  // Archivos
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 3000,
  "files.defaultLanguage": "markdown",
  
  // Todo Tree para notas de escritura
  "todo-tree.general.tags": [
    "TODO",
    "REVISAR",
    "CONTINUIDAD",
    "INVESTIGAR",
    "IDEA",
    "REESCRIBIR",
    "NOTA"
  ],
  "todo-tree.highlights.defaultHighlight": {
    "gutterIcon": true
  },
  "todo-tree.highlights.customHighlight": {
    "REVISAR": { "foreground": "#ff9800", "icon": "pencil" },
    "CONTINUIDAD": { "foreground": "#e91e63", "icon": "link" },
    "INVESTIGAR": { "foreground": "#2196f3", "icon": "search" },
    "IDEA": { "foreground": "#4caf50", "icon": "light-bulb" },
    "REESCRIBIR": { "foreground": "#ff5722", "icon": "sync" },
    "NOTA": { "foreground": "#9c27b0", "icon": "note" }
  }
}
